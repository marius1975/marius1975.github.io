<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shadow Forge - a shared puzzle</title>
  <meta name="description" content="A friend shared a Shadow Forge puzzle with you.">
  <meta name="robots" content="noindex">
  <style>
    :root { --bg: #14171c; --card: #1f2329; --text: #f2efe9; --muted: #aab0b7; --accent: #e8a33d; --border: #2d3239; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
           background: radial-gradient(ellipse at top, #22303a 0%, var(--bg) 60%); color: var(--text);
           font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; padding: 16px; }
    .card { width: 100%; max-width: 420px; background: var(--card); border: 1px solid var(--border);
            border-radius: 22px; padding: 28px 22px; text-align: center; box-shadow: 0 18px 50px rgba(0,0,0,.45); }
    h1 { font-size: 26px; margin: 0 0 6px; letter-spacing: .5px; color: var(--accent); font-family: Georgia, serif; }
    p { color: var(--muted); line-height: 1.5; margin: 8px 0 18px; }
    .code { display: inline-block; font-size: 22px; font-weight: 700; letter-spacing: 2px; padding: 10px 18px;
            border: 1px dashed var(--accent); border-radius: 12px; margin: 4px 0 22px; color: var(--text); }
    a.button { display: block; text-decoration: none; font-weight: 700; font-size: 17px; padding: 15px 18px;
               border-radius: 14px; margin: 10px 0; }
    .primary { background: var(--accent); color: #1a1408; }
    .secondary { background: transparent; color: var(--text); border: 1px solid var(--border); }
    .hint { font-size: 13px; margin-top: 18px; }
  </style>
</head>
<body>
  <main class="card">
    <h1>Shadow Forge</h1>
    <p id="lead">A friend shared a puzzle with you.</p>
    <div class="code" id="code">-</div>
    <a class="button primary" id="play" href="https://play.google.com/store/apps/details?id=com.marius.shadowforge">Get Shadow Forge on Google Play</a>
    <a class="button secondary" id="open" href="#">I have the game - open the puzzle</a>
    <p class="hint" id="hint">After installing, open the game: the puzzle is waiting under Shared.</p>
  </main>
  <script>
    // A phone with the game opens /sf/ links in the game directly (Android App Link); this page is
    // only seen without the game, or inside in-app browsers that keep links to themselves.
    (function () {
      var PACKAGE = "com.marius.shadowforge";
      var raw = new URLSearchParams(location.search).get("c") || "";
      var code = /^[A-Za-z0-9-]{1,40}$/.test(raw) ? raw.toUpperCase() : "";
      var play = "https://play.google.com/store/apps/details?id=" + PACKAGE +
        (code ? "&referrer=" + encodeURIComponent("puzzle=" + code) : "");
      var texts = {
        en: ["A friend shared a puzzle with you.", "Get Shadow Forge on Google Play", "I have the game - open the puzzle", "After installing, open the game: the puzzle is waiting under Shared."],
        ro: ["Un prieten ți-a trimis un puzzle.", "Ia Shadow Forge din Google Play", "Am jocul - deschide puzzle-ul", "După instalare, deschide jocul: puzzle-ul te așteaptă la Primite."],
        es: ["Un amigo te compartió un puzzle.", "Consigue Shadow Forge en Google Play", "Tengo el juego: abrir el puzzle", "Tras instalarlo, abre el juego: el puzzle te espera en Compartidos."],
        pt: ["Um amigo partilhou um puzzle consigo.", "Obter Shadow Forge no Google Play", "Tenho o jogo - abrir o puzzle", "Depois de instalar, abra o jogo: o puzzle espera em Partilhados."],
        de: ["Ein Freund hat ein Rätsel mit dir geteilt.", "Shadow Forge bei Google Play holen", "Ich habe das Spiel - Rätsel öffnen", "Nach der Installation das Spiel öffnen: Das Rätsel wartet unter Geteilt."],
        fr: ["Un ami a partagé un puzzle avec vous.", "Obtenir Shadow Forge sur Google Play", "J'ai le jeu - ouvrir le puzzle", "Après l'installation, ouvrez le jeu : le puzzle vous attend dans Partagés."],
        zh: ["朋友与你分享了一个拼图。", "在 Google Play 获取 Shadow Forge", "我已有游戏 - 打开拼图", "安装后打开游戏：拼图在“分享”中等你。"],
        ja: ["友だちがパズルを共有しました。", "Google Play で Shadow Forge を入手", "ゲームを持っている - パズルを開く", "インストール後にゲームを開くと、「共有」でパズルが待っています。"],
        it: ["Un amico ha condiviso un puzzle con te.", "Scarica Shadow Forge da Google Play", "Ho il gioco - apri il puzzle", "Dopo l'installazione apri il gioco: il puzzle ti aspetta in Condivisi."],
        ko: ["친구가 퍼즐을 공유했습니다.", "Google Play에서 Shadow Forge 받기", "게임이 있어요 - 퍼즐 열기", "설치 후 게임을 열면 공유됨에서 퍼즐이 기다립니다."]
      };
      var lang = (navigator.language || "en").slice(0, 2).toLowerCase();
      var t = texts[lang] || texts.en;
      document.documentElement.lang = texts[lang] ? lang : "en";
      document.getElementById("lead").textContent = t[0];
      document.getElementById("play").textContent = t[1];
      document.getElementById("open").textContent = t[2];
      document.getElementById("hint").textContent = t[3];
      document.getElementById("code").textContent = code || "-";
      document.getElementById("play").href = play;
      // Chrome opens an intent: link in the installed game (with this same address as its data),
      // and falls back to Google Play when the game is missing.
      var here = location.host + location.pathname + location.search;
      document.getElementById("open").href = "intent://" + here + "#Intent;scheme=https;package=" + PACKAGE +
        ";S.browser_fallback_url=" + encodeURIComponent(play) + ";end";
    })();
  </script>
</body>
</html>

